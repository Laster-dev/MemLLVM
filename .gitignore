# ==========================================
# MemLLVM - Git Ignore Rules
# ==========================================

# Build output directories
build/
bin/
out/
dist/
target/

# Visual Studio / IDE files
.vs/
.vscode/
*.vcxproj.user
*.sln.docstates
*.suo
*.user
*.userosscache
*.sln.ide

# CMake temporary files
CMakeCache.txt
CMakeFiles/
CMakeScripts/
Testing/
Makefile
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
_deps/
CMakeUserPresets.json

# Compiled object and library files
*.obj
*.o
*.lib
*.a
*.exp

# Executables, DLLs, and flat binaries
*.exe
*.dll
*.dylib
*.so
*.bin
*.manifest

# Allow release artifacts and Tools directory to be tracked
!release_artifacts/
!release_artifacts/**
!Tools/
!Tools/**
!Tools/*.exe

# Debugging and symbol files
*.pdb
*.idb
*.ilk
*.map
*.ipdb
*.iobj
*.dmp
*.log

# LLVM temporary IR / disassembly
*.ll
*.bc
*.s
*.asm

# OS generated files
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store

# Temporary files
*.tmp
*.temp
*~
*.swp

*.zip


# ==========================================
# mimikatz example & CSLoader exceptions
# ==========================================
# build scripts must be tracked even though build/ dirs are ignored
!examples/mimikatz/build/
examples/mimikatz/build/*
!examples/mimikatz/build/*.bat
!examples/mimikatz/build/*.py
!examples/mimikatz/build/sim_scloader.c
!examples/mimikatz/build/probe_loader.c
# prebuilt import libraries required by the flat link (no system CRT)
!examples/mimikatz/lib/
!examples/mimikatz/lib/**
# static freestanding runtime linked into every payload
!ltl/ltl.lib
# inline asm source for CSLoader
!CSLoader/CallShellcode.asm
# per-project intermediate dirs (rebuilt from scratch on CI)
examples/mimikatz/mimikatz/x64/
examples/mimikatz/mimilib/x64/
examples/mimikatz/mimilove/x64/
examples/mimikatz/mimispool/x64/
examples/mimikatz/Win32/
