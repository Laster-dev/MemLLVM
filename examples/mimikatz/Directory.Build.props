<?xml version="1.0" encoding="utf-8"?>
<!--
  全局编译语义修正（ClangCL 工具集）

  mimikatz 上游源码大量在头文件里直接定义全局变量，例如：
    modules/kull_m_output.h        FILE * logfile;
    inc/globals.h                  DWORD MIMIKATZ_NT_MAJOR_VERSION, ...;
    modules/kull_m_memory.h        KULL_M_MEMORY_HANDLE KULL_M_MEMORY_GLOBAL_OWN_HANDLE;
    mimilib/sekurlsadbg/kwindbg.h  USHORT NtBuildNumber;

  这些是 C89 的 tentative definition（暂定义），依赖链接器把它们当 common symbol 合并。
  cl.exe 和 GCC < 10 默认 -fcommon，所以上游用 MSVC 构建一切正常；
  clang 11 起默认 -fno-common，每个包含该头文件的 .c 都会产出强定义，
  于是 lld-link 报 duplicate symbol。

  这里对 ClangCL 统一恢复 -fcommon，使语义与官方 MSVC 构建完全一致
  （每个符号最终仍是唯一一份、零初始化），而不是逐个符号去打 extern 补丁。
-->
<Project>
  <!--
    固定 LLVM 工具链版本（ClangCL 工具集）

    MemLLVM.dll 是用 LLVM 22.1.8（commit ca7933e4）编译的 out-of-tree pass 插件，
    而 VS 自带的 clang-cl 是 22.1.3。pass 插件与宿主 clang 之间没有 ABI 稳定保证，
    版本不一致时表现为「Plugin registered successfully」之后立刻 SIGSEGV。
    实测：22.1.3 → 任何文件（含 int main(){}）都崩；22.1.8 → 正常。

    所以把整个解决方案的 LLVM 指向 22.1.8 那套，不要混用两套 LLVM
    （mimilib 开了 /GL，混版本还会让 LTO 的 bitcode 版本对不上）。
    注意 LLVMToolsVersion 必须给主版本号，否则 LLVMIncludeVersion 取不到，
    clang 内置头文件目录会算成 lib\clang\\include 而找不到。
  -->
  <PropertyGroup>
    <!-- 三个路径属性都带条件默认值：本地开发机不改任何东西照常工作；
         CI（GitHub Actions）用 /p: 覆盖 LLVMInstallDir 和 MemLLVMPython 即可，
         MEMLLVM_DIR 自动按本文件所在目录推导，检出路径无关。 -->
    <LLVMInstallDir Condition="'$(LLVMInstallDir)'==''">C:\LLVM-22-dev</LLVMInstallDir>
    <LLVMToolsVersion>22</LLVMToolsVersion>
    <!-- MemLLVM 源码仓根目录（本文件位于 <仓库根>\examples\mimikatz\，上跳两级）。
         文档里写作 $(MEMLLVM_DIR)\bin\MemLLVM.dll，这里必须真的定义出来，否则展开成
         \bin\MemLLVM.dll，插件根本加载不到。值自带尾反斜杠（来自 ..\..\），
         所以所有引用都写成 $(MEMLLVM_DIR)bin\... 形式（MEMLLVM_DIR 后不再加 \）。 -->
    <MEMLLVM_DIR Condition="'$(MEMLLVM_DIR)'==''">$(MSBuildThisFileDirectory)..\..\</MEMLLVM_DIR>
    <!-- 插件开关：不定义它，下面那条 /clang:-fpass-plugin 的 Condition 永远不成立，
         构建照常"成功"但一个文件都没过插件 —— 这正是 VS 构建的 bin 一跑就崩的原因。
         这里默认打开；要编普通 PE 时在命令行 /p:EnableMemLLVM=false 覆盖。 -->
    <EnableMemLLVM>true</EnableMemLLVM>
    <!-- 打包扁平镜像用的 Python（可执行文件名即可，只要在 PATH 里） -->
    <MemLLVMPython Condition="'$(MemLLVMPython)'==''">C:\Users\admin\.workbuddy-ai\binaries\python\versions\3.13.12\python.exe</MemLLVMPython>
  </PropertyGroup>

  <ItemDefinitionGroup Condition="'$(PlatformToolset)' == 'ClangCL'">
    <ClCompile>
      <!-- -fcommon：恢复 C89 暂定义（common symbol）语义，见上方说明 -->
      <!-- /utf-8：源码按 UTF-8 解析。clang 本身假定 UTF-8，显式声明与上游 Win32 配置一致 -->
      <AdditionalOptions>-fcommon /utf-8 %(AdditionalOptions)</AdditionalOptions>
      <!--
        MemLLVM pass 插件：对所有 ClangCL 工程生效（mimilib 的 obj 也必须过一遍，
        否则静态库里仍留着外部导入引用）。

        注意必须写成 /clang:-fpass-plugin=... 透传给 cc1。clang-cl 自己不认识
        -fpass-plugin，直接写只会得到一条 "unknown argument ignored" 警告，
        构建照常"成功"但插件根本没跑。

        默认关闭，因为打开后产出的 obj 完全没有 Win32 导入，只能配扁平链接
        （/NODEFAULTLIB + ltl.lib + /ENTRY:main）才连得上；常规 PE 链接会失败。

        扁平链路现在已经完整走通（0 未解析符号、0 导入表），步骤见根目录
        MemLLVM-实验结论.md 与 build/compile_all.bat、build/link_flat.bat。
      -->
      <AdditionalOptions Condition="'$(Configuration)|$(Platform)'=='Release|x64' and '$(EnableMemLLVM)'=='true'">/clang:-fpass-plugin="$(MEMLLVM_DIR)bin\MemLLVM.dll" /clang:-fno-jump-tables /clang:-fno-builtin /clang:-ffreestanding /GS- %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
